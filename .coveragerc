[run]
# Mesure la couverture pour tout le code critique
source = app
omit = 
    tests
    test_*
    __pycache__
    venv
    .venv
    build
    builds
    docs
    app/web
    app/mcp

[report]
# Seuil réaliste de départ - à remonter progressivement
fail_under = 60
show_missing = True
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:

[html]
directory = htmlcov
