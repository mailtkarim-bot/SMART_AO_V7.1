# =============================================================================
# SMART_AO V7 - Configuration Docker
# =============================================================================
# Fichier: .env.docker
# Auteur: NOOR - Architecte Principal
# Version: 0.1.0
# Date: 04/08/2026
# 
# INSTRUCTIONS:
#   1. Copiez ce fichier en .env : cp .env.docker .env
#   2. Modifiez les valeurs selon votre environnement
#   3. NE COMMITTEZ PAS .env (il est dans .gitignore)
# =============================================================================

# =============================================================================
# CONFIGURATION APPLICATION
# =============================================================================

# Port de l'application (accès HTTP)
APP_PORT=8000

# Environnement : development | staging | production
ENVIRONMENT=development

# Niveau de logs : DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# CONFIGURATION POSTGRESQL
# =============================================================================

# Hôte PostgreSQL (nom du service dans docker-compose)
DB_HOST=postgres

# Port PostgreSQL
DB_PORT=5432

# Nom de la base de données
DB_NAME=smart_ao_v7

# Utilisateur PostgreSQL
DB_USER=smart_ao

# Mot de passe PostgreSQL (CHANGEZ-CELA EN PRODUCTION !)
DB_PASSWORD=your_secure_password_change_me

# =============================================================================
# CONFIGURATION QDRANT (Recherche Vectorielle)
# =============================================================================

# Hôte Qdrant (nom du service dans docker-compose)
QDRANT_HOST=qdrant

# Port HTTP Qdrant
QDRANT_PORT=6333

# Port gRPC Qdrant
QDRANT_GRPC_PORT=6334

# =============================================================================
# CONFIGURATION RESEAU (Optionnel)
# =============================================================================

# Pour accéder à PostgreSQL depuis l'hôte :
# Exposez le port sur l'hôte en modifiant docker-compose.yml
# ou utilisez : docker exec -it smart_ao_postgres psql

# =============================================================================
# NOTES DE SÉCURITÉ
# =============================================================================
# 1. En PRODUCTION, changez TOUS les mots de passe
# 2. Utilisez des variables d'environnement sécurisées (secrets)
# 3. Ne commitez JAMAIS .env dans git
# 4. Pour la production, utilisez docker-compose.prod.yml avec des configs spécifiques
# =============================================================================
